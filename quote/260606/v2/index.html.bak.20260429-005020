<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>初提案第二版｜六六大順・古風盛宴｜村山良作 MURAYAMA GOODJOB</title>
<meta name="description" content="六六大順・古風盛宴初提案第二版，定案方案 A 墨山幽境與追加項目報價。">
<meta property="og:title" content="初提案第二版｜方案 A ── 墨山幽境">
<meta property="og:description" content="2026/06/06 新竹國賓大飯店 Ballroom A 謝師宴佈置提案。">
<meta property="og:url" content="https://goodjob.weddingwishlove.com/quote/260606/v2">
<meta property="og:image" content="https://goodjob.weddingwishlove.com/quote/260606/v2/images/photo-zone-text.jpg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@400;500;600;700;900&family=LXGW+WenKai+TC:wght@300;400;700&display=swap" rel="stylesheet">
<style>
:root {
  --ink: #171713;
  --muted: #5f5b52;
  --soft: #8a8174;
  --rice: #fbf7ee;
  --paper: #efe6d4;
  --paper-deep: #dfd0b7;
  --jade:         #1a2f23;
  --jade-mid:     #2d5a3d;
  --jade-light:   #3d7a52;
  --jade-glow:    rgba(61,122,82,0.12);
  --gold:         #c4a35a;
  --gold-light:   #d9c07a;
  --gold-dark:    #a08840;
  --jade-soft:    #284534;
  --gold-deep:    #8e6f2f;
  --rouge: #8a3e35;
  --line: rgba(142, 111, 47, .28);
  --shadow: 0 18px 48px rgba(23, 23, 19, .12);
  --radius: 8px;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  color: var(--ink);
  background: var(--rice);
  font-family: "Noto Sans TC", system-ui, sans-serif;
  line-height: 1.8;
  -webkit-font-smoothing: antialiased;
}
body::before {
  content: "";
  position: fixed;
  inset: 0;
  pointer-events: none;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 220 220' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.035'/%3E%3C/svg%3E");
  z-index: 20;
}
img { max-width: 100%; }
a { color: inherit; }
.container {
  width: min(1120px, calc(100% - 40px));
  margin: 0 auto;
}
.hero {
  position: relative;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 3rem 2rem;
  background: var(--jade);
  overflow: hidden;
}

/* Layered atmospheric gradients */
.hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse 80% 60% at 25% 40%, rgba(61,122,82,0.4) 0%, transparent 70%),
    radial-gradient(ellipse 60% 50% at 75% 30%, rgba(196,163,90,0.12) 0%, transparent 60%),
    radial-gradient(ellipse 100% 80% at 50% 100%, rgba(0,0,0,0.3) 0%, transparent 50%),
    linear-gradient(175deg, #152a1c 0%, #1a2f23 35%, #0f1f16 70%, #0a1610 100%);
  z-index: 0;
}

/* Subtle mountain silhouette */
.hero::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 200px;
  background:
    linear-gradient(135deg, transparent 33%, rgba(196,163,90,0.03) 33%, rgba(196,163,90,0.03) 66%, transparent 66%),
    linear-gradient(to top, rgba(0,0,0,0.2) 0%, transparent 100%);
  z-index: 0;
}

/* SVG animation layers */
.hero-clouds, .hero-particles {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}
.hero-particles { z-index: 1; }

.hero-inner {
  position: relative;
  z-index: 2;
  max-width: 720px;
}

.hero-logo {
  width: 110px;
  margin: 0 auto 2rem;
  display: block;
  filter: drop-shadow(0 4px 12px rgba(0,0,0,0.3));
  animation: heroFadeIn 1.2s ease both;
}

.hero-overline {
  font-family: 'LXGW WenKai TC', serif;
  font-weight: 300;
  font-size: 0.82rem;
  letter-spacing: 0.5em;
  color: var(--gold-light);
  margin-bottom: 1.2rem;
  opacity: 0;
  animation: heroFadeIn 1s 0.3s ease both;
}

.hero-title {
  font-family: 'Noto Serif TC', serif;
  font-weight: 900;
  font-size: clamp(2.2rem, 5vw, 3.5rem);
  color: #fff;
  line-height: 1.15;
  margin-bottom: 0.6rem;
  letter-spacing: 0.06em;
  text-shadow: 0 4px 30px rgba(0,0,0,0.25);
  opacity: 0;
  animation: heroSlideUp 1.2s 0.5s ease both;
}

/* 「山院」特別設計 — 金色書法大字 */
.hero-title .shan-yuan {
  display: block;
  font-size: clamp(4.5rem, 12vw, 8rem);
  color: var(--gold-light);
  letter-spacing: 0.2em;
  line-height: 1.1;
  margin-bottom: 0.2rem;
  text-shadow:
    0 2px 20px rgba(196,163,90,0.3),
    0 8px 40px rgba(0,0,0,0.2);
  background: linear-gradient(180deg, #e8d494 0%, #c4a35a 40%, #a08840 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  filter: drop-shadow(0 4px 15px rgba(196,163,90,0.25));
}

.hero-subtitle {
  font-family: 'Noto Serif TC', serif;
  font-weight: 400;
  font-size: clamp(0.95rem, 2.2vw, 1.25rem);
  color: var(--gold-light);
  letter-spacing: 0.15em;
  margin-bottom: 3rem;
  opacity: 0;
  animation: heroFadeIn 1s 0.8s ease both;
}

/* Gold ornamental line */
.hero-ornament {
  width: 80px;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--gold), transparent);
  margin: 0 auto 2.5rem;
  opacity: 0;
  animation: heroFadeIn 1s 0.7s ease both;
}

.hero-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 2rem;
  justify-content: center;
  opacity: 0;
  animation: heroFadeIn 1s 1s ease both;
}

.hero-meta-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.3rem;
}

.hero-meta-label {
  font-size: 0.65rem;
  letter-spacing: 0.25em;
  color: rgba(255,255,255,0.35);
  text-transform: uppercase;
}

.hero-meta-value {
  font-family: 'Noto Serif TC', serif;
  font-weight: 500;
  font-size: 0.92rem;
  color: rgba(255,255,255,0.85);
  letter-spacing: 0.05em;
}

.hero-scroll-hint {
  position: absolute;
  bottom: 2.5rem;
  left: 50%;
  transform: translateX(-50%);
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.5rem;
  color: rgba(255,255,255,0.25);
  font-size: 0.65rem;
  letter-spacing: 0.3em;
  animation: heroScrollFloat 2.5s ease-in-out infinite;
}

.hero-scroll-line {
  width: 1px;
  height: 40px;
  background: linear-gradient(to bottom, rgba(196,163,90,0.4), transparent);
}

@keyframes heroFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
@keyframes heroSlideUp {
  from { opacity: 0; transform: translateY(20px); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes heroScrollFloat {
  0%, 100% { transform: translateX(-50%) translateY(0); }
  50% { transform: translateX(-50%) translateY(-10px); }
}


section {
  padding: 84px 0;
}
.section-head {
  max-width: 720px;
  margin-bottom: 36px;
}
.section-head.center {
  margin-left: auto;
  margin-right: auto;
  text-align: center;
}
.section-title {
  margin: 0;
  color: var(--jade);
  font-size: clamp(28px, 4vw, 48px);
}
.section-desc {
  margin: 14px 0 0;
  color: var(--muted);
  font-size: 16px;
}
.selected-plan {
  background: var(--paper);
}
.plan-layout {
  display: grid;
  grid-template-columns: 1.12fr .88fr;
  gap: 28px;
  align-items: stretch;
}
.image-panel {
  border-radius: var(--radius);
  overflow: hidden;
  background: #d7c7ad;
  box-shadow: var(--shadow);
  cursor: zoom-in;
}
.image-panel img {
  display: block;
  width: 100%;
  height: 100%;
  min-height: 420px;
  object-fit: contain;
  background: var(--paper);
}
.plan-copy {
  display: grid;
  gap: 18px;
}
.quote-panel,
.detail-panel,
.summary-panel,
.module-card {
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: var(--rice);
}
.quote-panel {
  padding: 28px;
  border-left: 6px solid var(--gold);
}
.tag {
  display: inline-flex;
  align-items: center;
  min-height: 30px;
  padding: 3px 10px;
  color: var(--gold-deep);
  background: rgba(194, 160, 90, .16);
  border-radius: 999px;
  font-size: 13px;
  font-weight: 700;
}
.plan-name {
  margin: 16px 0 8px;
  color: var(--jade);
  font-size: clamp(28px, 4vw, 44px);
}
.price {
  margin: 18px 0 4px;
  color: var(--rouge);
  font-family: "Noto Serif TC", serif;
  font-size: clamp(36px, 5vw, 58px);
  font-weight: 900;
}
.small-note {
  margin: 0;
  color: var(--soft);
  font-size: 14px;
}
.detail-panel {
  padding: 24px;
}
.detail-list {
  display: grid;
  gap: 10px;
  margin: 0;
  padding: 0;
  list-style: none;
}
.detail-list li {
  position: relative;
  padding-left: 18px;
  color: var(--muted);
}
.detail-list li::before {
  content: "";
  position: absolute;
  left: 0;
  top: .8em;
  width: 7px;
  height: 7px;
  border-radius: 999px;
  background: var(--gold);
}
.modules {
  background: var(--rice);
}
.module-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22px;
}
.module-card {
  overflow: hidden;
  box-shadow: 0 10px 30px rgba(23, 23, 19, .07);
}
.module-media {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1px;
  background: var(--line);
}
.module-media.single {
  grid-template-columns: 1fr;
}
.module-media img {
  width: 100%;
  aspect-ratio: 4 / 3;
  object-fit: contain;
  display: block;
  background: var(--paper);
  cursor: zoom-in;
}
.module-body {
  padding: 22px;
}
.module-title {
  margin: 0 0 12px;
  color: var(--jade);
  font-size: 22px;
}
.image-note {
  margin: -4px 0 10px;
  color: var(--gold-deep);
  font-size: 13px;
  font-weight: 700;
}
.option-table {
  width: 100%;
  border-collapse: collapse;
  margin-top: 14px;
}
.option-table th,
.option-table td {
  padding: 12px 0;
  border-top: 1px solid rgba(142, 111, 47, .2);
  vertical-align: top;
  text-align: left;
  color: var(--muted);
  font-size: 14px;
}
.option-table th {
  width: 34%;
  color: var(--ink);
  font-weight: 700;
}
.option-table td:last-child {
  text-align: right;
  color: var(--jade);
  font-weight: 700;
  white-space: nowrap;
}
.summary {
  color: #fff;
  background:
    linear-gradient(135deg, rgba(138, 62, 53, .18), transparent 40%),
    var(--jade);
}
.summary .section-title,
.summary .kicker {
  color: var(--gold);
}
.summary .section-desc {
  color: rgba(255, 255, 255, .72);
}
.summary-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22px;
}
.summary-panel {
  padding: 26px;
  background: rgba(255, 255, 255, .055);
  border-color: rgba(255, 255, 255, .16);
}
.summary-panel h3 {
  margin: 0 0 14px;
  color: #ead899;
  font-size: 24px;
}
.summary-table {
  width: 100%;
  border-collapse: collapse;
}
.summary-table td {
  padding: 11px 0;
  border-top: 1px solid rgba(255, 255, 255, .1);
  color: rgba(255, 255, 255, .74);
}
.summary-table td:last-child {
  text-align: right;
  color: #fff;
  font-weight: 700;
}
.summary-table .total td {
  color: #ead899;
  font-size: 22px;
  font-family: "Noto Serif TC", serif;
  font-weight: 900;
}
.summary-notes {
  margin-top: 28px;
  padding: 24px;
  background: rgba(0, 0, 0, .16);
  border-left: 3px solid rgba(194, 160, 90, .42);
  border-radius: var(--radius);
}
.summary-notes ul {
  margin: 0;
  padding: 0;
  columns: 2;
  column-gap: 36px;
  list-style: none;
}
.summary-notes li {
  position: relative;
  break-inside: avoid;
  padding: 4px 0 4px 18px;
  color: rgba(255, 255, 255, .64);
  font-size: 14px;
}
.summary-notes li::before {
  content: "※";
  position: absolute;
  left: 0;
  color: rgba(234, 216, 153, .72);
}
.summary-notes .note-emphasis {
  color: #ead899;
  font-weight: 700;
}
.summary-notes .note-emphasis::before {
  color: #ead899;
}
.budget {
  display: inline-flex;
  margin-top: 18px;
  padding: 8px 12px;
  border: 1px solid rgba(234, 216, 153, .3);
  color: #ead899;
  border-radius: 999px;
  font-weight: 700;
}
.notes {
  background: var(--paper);
}
.note-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 22px;
}
.note-box {
  padding: 24px;
  border-radius: var(--radius);
  background: var(--rice);
  border: 1px solid var(--line);
}
.note-box h3 {
  margin: 0 0 12px;
  color: var(--jade);
}
.note-box p {
  margin: 0;
  color: var(--muted);
}
.footer {
  background: #0d1610;
  text-align: center;
  padding: 3.5rem 2rem;
}

.footer-logo {
  width: 50px;
  margin: 0 auto 1.5rem;
  display: block;
  opacity: 0.6;
}

.footer-brand {
  font-family: 'Noto Serif TC', serif;
  font-weight: 600;
  font-size: 1rem;
  color: rgba(255,255,255,0.6);
  letter-spacing: 0.08em;
  margin-bottom: 0.4rem;
}

.footer-tagline {
  font-family: 'LXGW WenKai TC', serif;
  font-weight: 300;
  font-size: 0.82rem;
  color: rgba(255,255,255,0.3);
  letter-spacing: 0.15em;
  margin-bottom: 1rem;
}

.footer a {
  color: var(--gold);
  text-decoration: none;
  font-size: 0.85rem;
  transition: color 0.3s;
}
.footer a:hover {
  color: var(--gold-light);
}

.footer-disclaimer {
  font-size: 0.72rem;
  color: rgba(255,255,255,0.2);
  margin-top: 1.5rem;
  letter-spacing: 0.03em;
}

.lightbox {
  position: fixed;
  inset: 0;
  z-index: 30;
  display: none;
  align-items: center;
  justify-content: center;
  padding: 20px;
  background: rgba(0, 0, 0, .86);
}
.lightbox.active { display: flex; }
.lightbox img {
  max-width: min(100%, 1280px);
  max-height: 88vh;
  object-fit: contain;
}
.lightbox button {
  position: absolute;
  top: 18px;
  right: 18px;
  width: 44px;
  height: 44px;
  border: 1px solid rgba(255, 255, 255, .36);
  border-radius: 999px;
  color: #fff;
  background: rgba(255, 255, 255, .08);
  font-size: 24px;
  cursor: pointer;
}
@media (max-width: 900px) {
  .hero-meta,
  .plan-layout,
  .module-grid,
  .summary-grid,
  .note-grid {
    grid-template-columns: 1fr;
  }
  .hero { min-height: 82vh; }
  .image-panel img { min-height: 320px; }
}
@media (max-width: 560px) {
  .container { width: min(100% - 28px, 1120px); }
  section { padding: 58px 0; }
  .hero-inner { padding: 72px 0 42px; }
  .hero-meta { gap: 1px; }
  .meta-item { min-height: auto; padding: 14px; }
  .module-media { grid-template-columns: 1fr; }
  .summary-table td:last-child,
  .option-table td:last-child {
    white-space: normal;
  }
  .summary-notes ul {
    columns: 1;
  }
}
@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
}
</style>
</head>
<body>
<section class="hero">

  <!-- ── SVG 祥雲飄動 ── -->
  <svg class="hero-clouds" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <linearGradient id="cloudGold" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#c4a35a" stop-opacity="0"/>
        <stop offset="50%" stop-color="#c4a35a" stop-opacity="0.35"/>
        <stop offset="100%" stop-color="#c4a35a" stop-opacity="0"/>
      </linearGradient>
      <linearGradient id="cloudWhite" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#fff" stop-opacity="0"/>
        <stop offset="50%" stop-color="#fff" stop-opacity="0.12"/>
        <stop offset="100%" stop-color="#fff" stop-opacity="0"/>
      </linearGradient>
    </defs>

    <!-- 祥雲 1 — 大，金色，慢速右飄 -->
    <g fill="url(#cloudGold)" stroke="rgba(196,163,90,0.3)" stroke-width="0.5">
      <path d="M-200,180 Q-140,110 -60,150 Q0,80 80,130 Q140,60 220,110 Q280,50 360,100 Q400,130 360,170 Q320,210 260,195 Q200,220 140,195 Q80,220 20,195 Q-40,220 -100,195 Q-160,220 -200,195 Z">
        <animateTransform attributeName="transform" type="translate" values="-300,0;1700,0" dur="35s" repeatCount="indefinite"/>
      </path>
    </g>

    <!-- 祥雲 2 — 中，白色，反向飄 -->
    <g fill="url(#cloudWhite)" stroke="rgba(255,255,255,0.08)" stroke-width="0.5">
      <path d="M-150,380 Q-100,330 -30,360 Q20,310 90,345 Q140,300 200,340 Q230,365 200,385 Q160,410 110,395 Q60,415 10,395 Q-40,415 -90,395 Q-130,415 -150,400 Z">
        <animateTransform attributeName="transform" type="translate" values="1800,0;-400,0" dur="42s" repeatCount="indefinite"/>
      </path>
    </g>

    <!-- 祥雲 3 — 小，金色，慢 -->
    <g fill="url(#cloudGold)" opacity="0.6">
      <path d="M-80,560 Q-40,530 10,545 Q50,515 100,540 Q130,555 100,575 Q70,595 30,580 Q-10,595 -50,580 Q-80,590 -80,570 Z">
        <animateTransform attributeName="transform" type="translate" values="-200,0;1600,0" dur="50s" repeatCount="indefinite"/>
      </path>
    </g>

    <!-- 竹葉 1 — 大片，明顯綠色 -->
    <g fill="rgba(61,122,82,0.5)">
      <path d="M0,0 Q12,-25 4,-50 Q-4,-25 0,0 Z">
        <animateTransform attributeName="transform" type="translate" values="350,-60;280,960" dur="16s" repeatCount="indefinite"/>
        <animateTransform attributeName="transform" type="rotate" values="0,0,0;360,0,0" dur="10s" repeatCount="indefinite" additive="sum"/>
      </path>
    </g>

    <!-- 竹葉 2 -->
    <g fill="rgba(61,122,82,0.4)">
      <path d="M0,0 Q10,-20 3,-42 Q-4,-20 0,0 Z">
        <animateTransform attributeName="transform" type="translate" values="850,-40;770,960" dur="20s" repeatCount="indefinite"/>
        <animateTransform attributeName="transform" type="rotate" values="30,0,0;390,0,0" dur="13s" repeatCount="indefinite" additive="sum"/>
      </path>
    </g>

    <!-- 竹葉 3 — 金色葉 -->
    <g fill="rgba(196,163,90,0.35)">
      <path d="M0,0 Q8,-18 2,-38 Q-4,-18 0,0 Z">
        <animateTransform attributeName="transform" type="translate" values="1150,-80;1050,960" dur="24s" repeatCount="indefinite"/>
        <animateTransform attributeName="transform" type="rotate" values="60,0,0;420,0,0" dur="16s" repeatCount="indefinite" additive="sum"/>
      </path>
    </g>

    <!-- 竹葉 4 -->
    <g fill="rgba(61,122,82,0.35)">
      <path d="M0,0 Q9,-16 3,-35 Q-3,-16 0,0 Z">
        <animateTransform attributeName="transform" type="translate" values="550,-100;500,960" dur="22s" begin="5s" repeatCount="indefinite"/>
        <animateTransform attributeName="transform" type="rotate" values="15,0,0;375,0,0" dur="14s" repeatCount="indefinite" additive="sum"/>
      </path>
    </g>

    <!-- 遠山 — 層次山影呼吸動畫 -->
    <path fill="rgba(10,22,16,0.35)">
